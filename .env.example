# Supported live VLM providers: groq or openrouter
VLM_PROVIDER=
# Optional for groq (defaults to meta-llama/llama-4-scout-17b-16e-instruct)
# Required fixed model ID for openrouter (openrouter/free is disallowed)
VLM_MODEL=

# Provider API keys (populate locally in git-ignored .env; never commit real keys)
GROQ_API_KEY=
OPENROUTER_API_KEY=
